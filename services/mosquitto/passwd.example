# Mosquitto password file (EXAMPLE / PLACEHOLDER).
#
# Do NOT use this file as-is. The real `passwd` is generated by the installer
# with a random password and hashed by mosquitto_passwd.
#
# To generate it manually for local development, run:
#
#   docker run --rm -it eclipse-mosquitto:2 \
#     mosquitto_passwd -c -b /tmp/passwd guardioes "SUA_SENHA" \
#     && docker cp ... services/mosquitto/passwd
#
# or, with mosquitto-clients installed locally:
#
#   mosquitto_passwd -c -b services/mosquitto/passwd guardioes "SUA_SENHA"
#
# The username/password here must match MQTT_USER / MQTT_PASS in .env.
