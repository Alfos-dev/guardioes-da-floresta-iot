INFLUX_URL=http://influxdb:8086
INFLUX_ORG=ads
INFLUX_BUCKET=monitoramento
INFLUX_TOKEN=CHANGE_ME_USE_A_STRONG_TOKEN
INFLUX_INIT_USERNAME=admin
INFLUX_INIT_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# ---- v2: MQTT broker credentials (Mosquitto) ----
# These must match the user created in services/mosquitto/passwd
# (generate it with services/mosquitto/gen-passwd.sh).
MQTT_USER=guardioes
MQTT_PASS=CHANGE_ME_USE_A_STRONG_PASSWORD

# ---- v2: default device_id used by the serial bridge when the serial
# payload does not carry one ----
SERIAL_DEVICE_ID=esp32s3_serial

# ---- v2 Fase 3: Admin Panel ----
# Senha de acesso ao painel de administração (http://localhost:8000)
ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
# Chave secreta para geração de tokens JWT (deve ser aleatória e única)
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_KEY
